# DocuMind Configuration Template
# Copy this file to .env and supply your local secrets

# ==============================================================================
# Database (PostgreSQL + pgvector)
# ==============================================================================
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_secret
POSTGRES_DB=documind
POSTGRES_PORT=5432
DATABASE_URL=postgresql://documind:documind_secret@localhost:5432/documind

# ==============================================================================
# LLM & Embedding Providers
# ==============================================================================
# OpenAI API Key (required for embeddings and generation)
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
# text-embedding-3-small (1536 dim) or bge-small-en (384 dim, local)
EMBEDDING_MODEL=text-embedding-3-small

# Generator LLM Configuration
# gpt-4o-mini is recommended for fast, cost-effective streaming responses
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ==============================================================================
# Retrieval & RAG Parameters
# ==============================================================================
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.65
CHUNK_SIZE=400
CHUNK_OVERLAP=60

# ==============================================================================
# Backend API & Security
# ==============================================================================
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Optional static API key for protecting endpoints
DOCUMIND_API_KEY=
LOG_LEVEL=INFO
